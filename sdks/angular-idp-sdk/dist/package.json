{
  "name": "tokenidp-angular",
  "version": "0.1.0",
  "description": "Angular SDK for integrating TokenIDP OAuth 2.1 + OpenID Connect authentication.",
  "author": "",
  "license": "MIT",
  "sideEffects": false,
