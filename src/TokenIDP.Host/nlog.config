<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <variable name="logDirectory" value="${basedir}\Logs\"/>
  <variable name="appName" value="IDP_Server"/>
  <variable name="standardLayout" value="${longdate} | ${level:uppercase=true} | ${logger} | ${mdlc:CorrelationId:raw=true} | ${message} ${exception:format=ToString,data:maxInnerExceptionLevel=10:separator=\r\n}${newline}" />

  <targets async="true">

    <target name="tracefile" xsi:type="File" layout="${standardLayout}" fileName="${logDirectory}Trace.log" 
            archiveFileName="${logDirectory}Trace_{###}.log" archiveNumbering="Rolling" maxArchiveFiles="10" archiveAboveSize="10485760"/>

    <target name="debugfile" xsi:type="File" layout="${standardLayout}" fileName="${logDirectory}Debug.log" 
            archiveFileName="${logDirectory}Debug_{###}.log" archiveNumbering="Rolling" maxArchiveFiles="10" archiveAboveSize="10485760"/>

    <target name="infofile" xsi:type="File" layout="${standardLayout}" fileName="${logDirectory}Info.log" 
            archiveFileName="${logDirectory}Info_{###}.log" archiveNumbering="Rolling" maxArchiveFiles="5" archiveAboveSize="10485760"/>

    <target name="warnfile" xsi:type="File" layout="${standardLayout}" fileName="${logDirectory}Warn.log" 
            archiveFileName="${logDirectory}Warn_{###}.log" archiveNumbering="Rolling" maxArchiveFiles="5" archiveAboveSize="10485760"/>

    <target name="errorfile" xsi:type="File" layout="${standardLayout}" fileName="${logDirectory}Error.log" 
            archiveFileName="${logDirectory}Error_{###}.log" archiveNumbering="Rolling" maxArchiveFiles="2" archiveAboveSize="10485760"/>

    <target name="fatalfile" xsi:type="File" layout="${standardLayout}" fileName="${logDirectory}Fatal.log" 
            archiveFileName="${logDirectory}Fatal_{###}.log" archiveNumbering="Rolling" maxArchiveFiles="1" archiveAboveSize="10485760"/>

    <target name="eventlog" xsi:type="EventLog" source="${appName}" log="Application" 
            layout="${message}${newline}${exception:format=ToString}" />

    <!--<target name="database" xsi:type="Database" connectionString="${configsetting:name=ConnectionStrings.Logging}">
      <commandText>
        insert into dbo.EventLog (ApplicationName, MachineName, SessionId, Category, Date, Logger, Message, Exception)
        values (@ApplicationName, @MachineName, @SessionId, @Category, @Date,@Logger, @Message, @Exception);
      </commandText>

      <parameter name="@ApplicationName" layout="${appName}" />
      <parameter name="@MachineName" layout="${machinename}" />
      <parameter name="@SessionId" layout="${replace:inner=${aspnet-request-querystring}:searchFor=sessionId=:replaceWith=}" />
      <parameter name="@Category" layout="${level:upperCase=true}" />
      <parameter name="@Date" layout="${longdate}" />
      <parameter name="@Logger" layout="${logger}" />
      <parameter name="@Message" layout="${message}" />
      <parameter name="@Exception" layout="${exception:format=ToString,data:maxInnerExceptionLevel=10}" />
    </target>-->

  </targets>

  <rules>
    <logger name="System.*" finalMinLevel="Warn" />
    <logger name="Microsoft.*" finalMinLevel="Warn" />
    <logger name="Microsoft.Hosting.Lifetime*" finalMinLevel="Info" />
    <logger name="*" minlevel="Trace" writeTo="tracefile" />
    <logger name="*" minlevel="Debug" writeTo="debugfile" />
    <logger name="*" minlevel="Info" writeTo="infofile" />
    <logger name="*" minlevel="Warn" writeTo="warnfile" />
    <logger name="*" minlevel="Error" writeTo="errorfile,eventlog" />
    <logger name="*" minlevel="Fatal" writeTo="fatalfile,eventlog" />

    <!--<logger name="*" minlevel="Info" writeTo="database" />-->

  </rules>
</nlog>
