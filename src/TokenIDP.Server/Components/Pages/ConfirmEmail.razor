@page "/confirm-email"
@rendermode InteractiveServer

@using System.Net.Http.Json
@using Microsoft.AspNetCore.WebUtilities
@inject NavigationManager NavigationManager

<PageTitle>Confirm Email</PageTitle>

<div class="login-form">
    <div class="form-header">
        <h2>Confirm Your Email</h2>
        <p>We are verifying your email confirmation link.</p>
    </div>

    <div class="alert-danger" style="@GetErrorDisplayStyle()">
        @ErrorMessage
    </div>

    <div class="alert-success" style="@GetSuccessDisplayStyle()">
        @SuccessMessage
    </div>

    @if (!string.IsNullOrWhiteSpace(ReturnUrl))
    {
        <div class="back-to-login mt-3">
            <a @onclick="ReturnToLogin" class="text-link" style="cursor: pointer;">Back to Login</a>
        </div>
    }
</div>

@code {
    private string token = string.Empty;
    private string authorizationContextId = string.Empty;
    private string ErrorMessage = string.Empty;
    private string SuccessMessage = string.Empty;
    private string ReturnUrl = string.Empty;
    private bool attempted;

    protected override void OnInitialized()
    {
        var uri = new Uri(NavigationManager.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        if (query.TryGetValue("token", out var tokenValue))
        {
            token = tokenValue.ToString();
        }

        if (query.TryGetValue("ctx", out var ctxValue))
        {
            authorizationContextId = ctxValue.ToString();
        }

        ReturnUrl = BuildLoginUrl();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || attempted)
        {
            return;
        }

        attempted = true;
        await ConfirmEmailAsync();
        StateHasChanged();
    }

    private async Task ConfirmEmailAsync()
    {
        if (string.IsNullOrWhiteSpace(token))
        {
            ErrorMessage = "Confirmation token is missing.";
            SuccessMessage = string.Empty;
            return;
        }

        try
        {
            using var client = new HttpClient
            {
                BaseAddress = new Uri(NavigationManager.BaseUri)
            };

            var response = await client.PostAsJsonAsync(
                "auth/confirm-email",
                new
                {
                    token
                });

            if (!response.IsSuccessStatusCode)
            {
                ErrorMessage = "Invalid or expired confirmation link.";
                SuccessMessage = string.Empty;
                return;
            }

            ErrorMessage = string.Empty;
            SuccessMessage = "Your email has been confirmed successfully.";
        }
        catch
        {
            ErrorMessage = "Unable to confirm your email right now. Please try again.";
            SuccessMessage = string.Empty;
        }
    }

    private void ReturnToLogin()
    {
        if (!string.IsNullOrWhiteSpace(ReturnUrl))
        {
            NavigationManager.NavigateTo(ReturnUrl, forceLoad: true);
        }
    }

    private string BuildLoginUrl()
    {
        if (string.IsNullOrWhiteSpace(authorizationContextId))
        {
            return string.Empty;
        }

        return QueryHelpers.AddQueryString(
            "/login",
            new Dictionary<string, string?>(StringComparer.Ordinal)
            {
                ["ctx"] = authorizationContextId,
                ["confirmed"] = "1"
            });
    }

    private string GetErrorDisplayStyle() => string.IsNullOrEmpty(ErrorMessage) ? "display: none;" : "";
    private string GetSuccessDisplayStyle() => string.IsNullOrEmpty(SuccessMessage) ? "display: none;" : "";
}