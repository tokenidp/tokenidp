@page "/confirm-email"

@using Microsoft.AspNetCore.WebUtilities
@using TokenIDP.Core.Admin.Users
@using TokenIDP.Core.Admin.Users.UseCases

@inject NavigationManager NavigationManager
@inject EmailConfirmationUseCase EmailConfirmationUseCase

<PageTitle>Confirm Email</PageTitle>

<div class="login-form">
    <div class="form-header">
        <h2>Confirm Your Email</h2>
        <p>We are verifying your email confirmation link.</p>
    </div>

    <div class="alert-danger" style="@GetErrorDisplayStyle()">
        @ErrorMessage
    </div>

    <div class="alert-success" style="@GetSuccessDisplayStyle()">
        @SuccessMessage
    </div>

    @if (!string.IsNullOrWhiteSpace(ReturnUrl))
    {
        <div class="back-to-login mt-3">
            <a href="@ReturnUrl" class="text-link">Back to Login</a>
        </div>
    }
</div>

@code {
    private string Token = string.Empty;
    private string AuthorizationContextId = string.Empty;
    private string ErrorMessage = string.Empty;
    private string SuccessMessage = string.Empty;
    private string ReturnUrl = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var uri = new Uri(NavigationManager.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        Token = query.TryGetValue("token", out var tokenValue) ? tokenValue.ToString() : string.Empty;
        AuthorizationContextId = query.TryGetValue("ctx", out var ctxValue) ? ctxValue.ToString() : string.Empty;
        ReturnUrl = BuildLoginUrl();

        await ConfirmEmailAsync();
    }

    private async Task ConfirmEmailAsync()
    {
        if (string.IsNullOrWhiteSpace(Token))
        {
            ErrorMessage = "Confirmation token is missing.";
            SuccessMessage = string.Empty;
            return;
        }

        var response = await EmailConfirmationUseCase.CompleteEmailConfirmation(
            new CompleteEmailConfirmationCommand
            {
                RawToken = Token
            });

        if (!response.IsSuccess)
        {
            ErrorMessage = "Invalid or expired confirmation link.";
            SuccessMessage = string.Empty;
            return;
        }

        ErrorMessage = string.Empty;
        SuccessMessage = "Your email has been confirmed successfully.";
    }

    private string BuildLoginUrl()
    {
        if (string.IsNullOrWhiteSpace(AuthorizationContextId))
        {
            return string.Empty;
        }

        return QueryHelpers.AddQueryString(
            "/login",
            new Dictionary<string, string?>(StringComparer.Ordinal)
            {
                ["ctx"] = AuthorizationContextId,
                ["confirmed"] = "1"
            });
    }

    private string GetErrorDisplayStyle() => string.IsNullOrEmpty(ErrorMessage) ? "display: none;" : "";
    private string GetSuccessDisplayStyle() => string.IsNullOrEmpty(SuccessMessage) ? "display: none;" : "";
}
