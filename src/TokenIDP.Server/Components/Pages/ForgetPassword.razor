@page "/forgot-password"
@rendermode InteractiveServer

@using System.ComponentModel.DataAnnotations
@using System.Net.Http.Json
@inject NavigationManager NavigationManager
@using Microsoft.AspNetCore.WebUtilities

<PageTitle>Forget Password</PageTitle>

<div class="card">
    <div class="form-header">
        <div class="logo">
            <img src="/_content/TokenIDP.Server/images/TokenIDP.svg" alt="tokeidp logo" width="250" />
        </div>
        <h2>Reset Your Password</h2>
        <p>Enter your email to receive a reset link.</p>
    </div>

    <div class="alert-danger" id="general-error" style="@GetErrorDisplayStyle()">
        @ErrorMessage
    </div>

    <div class="alert-success" id="success-message" style="@GetSuccessDisplayStyle()">
        @SuccessMessage
    </div>

    <EditForm Model="@forgotPasswordModel" OnValidSubmit="HandlePasswordReset">
        <DataAnnotationsValidator />

        <div class="form-group">
            <label for="email">Email Address</label>
            <InputText @bind-Value="forgotPasswordModel.Email" id="email" type="email" class="form-control" />
            <ValidationMessage For="@(() => forgotPasswordModel.Email)" />
        </div>

        <button type="submit" class="btn btn-primary" style="margin-top:14px;">Send Reset Link</button>

        <div class="back-to-login">
            <a @onclick="ReturnToLogin" class="text-link" style="cursor: pointer;">? Back to Login</a>
        </div>
    </EditForm>
</div>

@code {

    public class ForgotPasswordModel
    {
        [Required(ErrorMessage = "Email is required.")]
        [EmailAddress(ErrorMessage = "Invalid email format.")]
        public string Email { get; set; }
    }

    private ForgotPasswordModel forgotPasswordModel = new();
    private string ErrorMessage = string.Empty;
    private string SuccessMessage = string.Empty;
    private string oauthParams = string.Empty;
    private string _clientId = string.Empty;

    protected override void OnInitialized()
    {
        var uri = NavigationManager.Uri;

        oauthParams = new Uri(uri).Query;

        var queryParams = QueryHelpers.ParseQuery(oauthParams);

        if (queryParams.TryGetValue("client_id", out var clientId))
        {
            _clientId = clientId.ToString();
        }
    }

    private async Task HandlePasswordReset()
    {
        try
        {
            using var client = new HttpClient
            {
                BaseAddress = new Uri(NavigationManager.BaseUri)
            };
            var response = await client.PostAsJsonAsync(
                "auth/forgot-password",
                new { email = forgotPasswordModel.Email, clientId = _clientId });

            if (!response.IsSuccessStatusCode)
            {
                ErrorMessage = "Unable to process the request right now. Please try again.";
                SuccessMessage = string.Empty;
                return;
            }

            SuccessMessage = "If the account exists, a password reset link will be sent.";
            ErrorMessage = string.Empty;

            forgotPasswordModel.Email = string.Empty;
        }
        catch
        {
            ErrorMessage = "Unable to process the request right now. Please try again.";
            SuccessMessage = string.Empty;
        }
    }

    private void ReturnToLogin()
    {
        NavigationManager.NavigateTo($"/authorize{oauthParams}");
    }

    private string GetErrorDisplayStyle() => string.IsNullOrEmpty(ErrorMessage) ? "display: none;" : "";

    private string GetSuccessDisplayStyle() => string.IsNullOrEmpty(SuccessMessage) ? "display: none;" : "";

}
