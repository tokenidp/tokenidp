@page "/forgot-password"

@using Microsoft.AspNetCore.WebUtilities

@inject NavigationManager NavigationManager

<PageTitle>Forget Password</PageTitle>

<div class="card">
    <div class="form-header">
        <div class="logo">
            <img src="/_content/TokenIDP.Server/images/TokenIDP.svg" alt="tokeidp logo" width="250" />
        </div>
        <h2>Reset Your Password</h2>
        <p>Enter your email to receive a reset link.</p>
    </div>

    <div class="alert-danger" id="general-error" style="@GetErrorDisplayStyle()">
        @ErrorMessage
    </div>

    <div class="alert-success" id="success-message" style="@GetSuccessDisplayStyle()">
        @SuccessMessage
    </div>

    <form method="post" action="/auth/forgot-password/form">
        <AntiforgeryToken />
        <input type="hidden" name="ctx" value="@AuthorizationContextId" />
        <input type="hidden" name="clientId" value="@ClientId" />

        <div class="form-group">
            <label for="email">Email Address</label>
            <input name="email" id="email" type="email" class="form-control" required />
        </div>

        <button type="submit" class="btn btn-primary" style="margin-top:14px;">Send Reset Link</button>

        <div class="back-to-login">
            <a href="@ReturnUrl" class="text-link">Back to Login</a>
        </div>
    </form>
</div>

@code {
    private string ErrorMessage = string.Empty;
    private string SuccessMessage = string.Empty;
    private string AuthorizationContextId = string.Empty;
    private string ClientId = string.Empty;
    private string ReturnUrl = "/authorize";

    protected override void OnInitialized()
    {
        var query = QueryHelpers.ParseQuery(new Uri(NavigationManager.Uri).Query);

        AuthorizationContextId = query.TryGetValue("ctx", out var ctx) ? ctx.ToString() : string.Empty;
        ClientId = query.TryGetValue("client_id", out var clientId) ? clientId.ToString() : string.Empty;
        ErrorMessage = query.TryGetValue("error_description", out var error) ? error.ToString() : string.Empty;

        if (query.TryGetValue("sent", out var sent) && sent == "1")
        {
            SuccessMessage = "If the account exists, a password reset link will be sent.";
        }

        ReturnUrl = string.IsNullOrWhiteSpace(AuthorizationContextId)
            ? "/authorize"
            : QueryHelpers.AddQueryString("/login", "ctx", AuthorizationContextId);
    }

    private string GetErrorDisplayStyle() => string.IsNullOrEmpty(ErrorMessage) ? "display: none;" : "";

    private string GetSuccessDisplayStyle() => string.IsNullOrEmpty(SuccessMessage) ? "display: none;" : "";
}
