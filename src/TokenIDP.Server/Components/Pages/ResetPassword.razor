@page "/reset-password"

@using Microsoft.AspNetCore.WebUtilities

@inject NavigationManager NavigationManager

<PageTitle>Reset Password</PageTitle>

<div class="card">
    <div class="form-header">
        <div class="logo">
            <img src="/_content/TokenIDP.Server/images/TokenIDP.svg" alt="tokeidp logo" width="250" />
        </div>
        <h2>Create New Password</h2>
        <p>Enter your new password below.</p>
    </div>

    <div class="alert-danger" style="@GetErrorDisplayStyle()">
        @ErrorMessage
    </div>

    <div class="alert-success" style="@GetSuccessDisplayStyle()">
        @SuccessMessage
    </div>

    @if (string.IsNullOrWhiteSpace(SuccessMessage))
    {
        <form method="post" action="/auth/reset-password/form">
            <AntiforgeryToken />
            <input type="hidden" name="token" value="@Token" />

            <div class="form-group">
                <label for="new-password">New Password</label>
                <div class="login-input-wrap">
                    <i class="fa-solid fa-lock login-input-icon" aria-hidden="true"></i>
                    <input name="newPassword" id="new-password" type="password" class="form-control" minlength="8" required />
                </div>
            </div>

            <div class="form-group">
                <label for="confirm-password">Confirm Password</label>
                <div class="login-input-wrap">
                    <i class="fa-solid fa-lock login-input-icon" aria-hidden="true"></i>
                    <input name="confirmPassword" id="confirm-password" type="password" class="form-control" minlength="8" required />
                </div>
            </div>

            <button type="submit" class="btn btn-primary">Reset Password</button>
        </form>
    }

    @if (!string.IsNullOrWhiteSpace(SuccessMessage))
    {
        <div class="back-to-login mt-3">
            <a href="/authorize" class="text-link">Back to Login</a>
        </div>
    }
</div>

@code {
    private string Token = string.Empty;
    private string ErrorMessage = string.Empty;
    private string SuccessMessage = string.Empty;

    protected override void OnInitialized()
    {
        var query = QueryHelpers.ParseQuery(new Uri(NavigationManager.Uri).Query);

        Token = query.TryGetValue("token", out var tokenValue) ? tokenValue.ToString() : string.Empty;
        ErrorMessage = query.TryGetValue("error_description", out var error) ? error.ToString() : string.Empty;

        if (query.TryGetValue("reset", out var reset) && reset == "1")
        {
            SuccessMessage = "Password reset successful. You can now sign in.";
        }
    }

    private string GetErrorDisplayStyle() => string.IsNullOrEmpty(ErrorMessage) ? "display: none;" : "";
    private string GetSuccessDisplayStyle() => string.IsNullOrEmpty(SuccessMessage) ? "display: none;" : "";
}
