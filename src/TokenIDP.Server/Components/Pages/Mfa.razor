@page "/mfa"
@using Microsoft.AspNetCore.WebUtilities

@inject NavigationManager Navigation

<div class="mfa-container">
    <h2>Multi-Factor Authentication</h2>
    <p>Please enter the 6-digit verification code sent to your email.</p>

    <form method="post" action="/mfa/verify/form" autocomplete="off" id="mfa-form">
        <AntiforgeryToken />
        <input type="hidden" name="uid" value="@UserId" />
        <input type="hidden" name="corid" value="@CorrelationId" />
        <input type="hidden" name="flow" value="@FlowType" />
        <input type="hidden" name="user_code" value="@UserCode" />
        <input type="hidden" name="code" id="mfa-code" />

        <div class="code-input-container">
            @for (var i = 0; i < 6; i++)
            {
                <input type="text"
                       maxlength="1"
                       class="code-input @(HasError ? "invalid" : "")"
                       autocomplete="one-time-code"
                       inputmode="numeric"
                       autocorrect="off"
                       autocapitalize="off"
                       spellcheck="false"
                       pattern="[0-9]*" />
            }
        </div>

        @if (HasError)
        {
            <div class="validation-message">@ErrorMessage</div>
        }

        <div class="button-container">
            <button type="submit" class="btn btn-primary">Verify</button>
            <button type="submit" class="btn btn-secondary" formaction="/mfa/resend/form">Resend Code</button>
        </div>
    </form>

    @if (WasResent)
    {
        <div class="resend-message">New code sent successfully!</div>
    }
</div>

<script>
    (() => {
        const form = document.getElementById('mfa-form');
        if (!form) return;

        const inputs = Array.from(form.querySelectorAll('.code-input'));
        const codeInput = document.getElementById('mfa-code');

        const syncCode = () => {
            codeInput.value = inputs.map(input => input.value).join('');
        };

        inputs.forEach((input, index) => {
            input.addEventListener('input', () => {
                input.value = input.value.replace(/\D/g, '').slice(0, 1);
                if (input.value && index < inputs.length - 1) {
                    inputs[index + 1].focus();
                }
                syncCode();
            });

            input.addEventListener('keydown', event => {
                if (event.key === 'Backspace' && !input.value && index > 0) {
                    inputs[index - 1].focus();
                }
            });

            input.addEventListener('paste', event => {
                event.preventDefault();
                const pasted = (event.clipboardData || window.clipboardData)
                    .getData('text')
                    .replace(/\D/g, '')
                    .slice(0, inputs.length);

                pasted.split('').forEach((digit, digitIndex) => {
                    inputs[digitIndex].value = digit;
                });

                const focusIndex = Math.min(pasted.length, inputs.length) - 1;
                if (focusIndex >= 0) {
                    inputs[focusIndex].focus();
                }
                syncCode();
            });
        });

        form.addEventListener('submit', syncCode);
    })();
</script>

@code {
    private string UserId = string.Empty;
    private string CorrelationId = string.Empty;
    private string FlowType = string.Empty;
    private string UserCode = string.Empty;
    private string ErrorMessage = string.Empty;
    private bool WasResent;
    private bool HasError => !string.IsNullOrWhiteSpace(ErrorMessage);

    protected override void OnInitialized()
    {
        var query = QueryHelpers.ParseQuery(new Uri(Navigation.Uri).Query);

        UserId = query.TryGetValue("uid", out var uid) ? uid.ToString() : string.Empty;
        CorrelationId = query.TryGetValue("corid", out var corid) ? corid.ToString() : string.Empty;
        FlowType = query.TryGetValue("flow", out var flow) ? flow.ToString() : string.Empty;
        UserCode = query.TryGetValue("user_code", out var userCode) ? userCode.ToString() : string.Empty;
        ErrorMessage = query.TryGetValue("error_description", out var error) ? error.ToString() : string.Empty;
        WasResent = query.TryGetValue("resent", out var resent) && resent == "1";
    }
}
