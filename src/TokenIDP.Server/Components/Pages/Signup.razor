@page "/signup"

@using Microsoft.AspNetCore.WebUtilities
@using TokenIDP.Core.Abstractions.Repositories
@using TokenIDP.Core.Foundation.Exceptions
@using TokenIDP.Core.OAuth.Abstractions
@using TokenIDP.Core.OAuth.Model
@using TokenIDP.Domain.AggregateRoots.Authorization

<PageTitle>Create Account</PageTitle>

@inject NavigationManager Navigation
@inject IAuthorizationRepository authorizationStore
@inject IAuthorizationPageUiUseCase PageUiUseCase

@if (!isRequestValid)
{
    <p style="color:red;">@requestErrorMessage</p>
}
else if (ui != null)
{

    <div class="card" data-theme="@ui.Theme" style="@GetCardStyle(ui.AccentColor)">
        <div class="logo">
            <img src="/_content/TokenIDP.Server/images/TokenIDP.svg" alt="tokeidp logo" width="250" />
        </div>
        <h1>Create Account</h1>
        <p style="margin-bottom:20px; color:var(--muted); text-align:center;">Create a free public account for @ui.ProductName.</p>

        <div class="alert-danger" style="@GetErrorDisplayStyle()">@ErrorMessage</div>

        <form method="post" action="/signup/form">
            <AntiforgeryToken />
            <input type="hidden" name="ctx" value="@authorizationContextId" />

            <div class="field">
                <label for="first-name">First Name</label>
                <div class="login-input-wrap">
                    <i class="fa-solid fa-user login-input-icon" aria-hidden="true"></i>
                    <input name="firstName" id="first-name" required />
                </div>
            </div>

            <div class="field">
                <label for="last-name">Last Name</label>
                <div class="login-input-wrap">
                    <i class="fa-solid fa-user login-input-icon" aria-hidden="true"></i>
                    <input name="lastName" id="last-name" required />
                </div>
            </div>

            <div class="field">
                <label for="email">Email</label>
                <div class="login-input-wrap">
                    <i class="fa-solid fa-envelope login-input-icon" aria-hidden="true"></i>
                    <input name="email" id="email" type="email" required />
                </div>
            </div>

            <div class="field">
                <label for="password">Password</label>
                <div class="login-input-wrap">
                    <i class="fa-solid fa-lock login-input-icon" aria-hidden="true"></i>
                    <input name="password" id="password" type="password" minlength="8" required />
                </div>
            </div>

            <div class="field">
                <label for="confirm-password">Confirm Password</label>
                <div class="login-input-wrap">
                    <i class="fa-solid fa-lock login-input-icon" aria-hidden="true"></i>
                    <input name="confirmPassword" id="confirm-password" type="password" minlength="8" required />
                </div>
            </div>

            <div class="field">
                <label for="user-name">User Name</label>
                <div class="login-input-wrap">
                    <i class="fa-solid fa-id-badge login-input-icon" aria-hidden="true"></i>
                    <input name="userName" id="user-name" required />
                </div>
            </div>

            <div class="field">
                <label for="phone-number">Phone Number</label>
                <div class="login-input-wrap">
                    <i class="fa-solid fa-phone login-input-icon" aria-hidden="true"></i>
                    <input name="phoneNumber" id="phone-number" required />
                </div>
            </div>

            <button type="submit" class="btn-primary">Create Account</button>
        </form>
    </div>

    <div class="footer">
        <a href="@BuildLoginUrl(created: false, verifyRequired: false)">Back to sign in</a>
    </div>
}

@code {
    private AuthorizationPageUi? ui;
    private PreAuthorization? preAuthorization;
    private bool isRequestValid = true;
    private string requestErrorMessage = string.Empty;
    private string ErrorMessage = string.Empty;
    private string authorizationContextId = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var query = QueryHelpers.ParseQuery(new Uri(Navigation.Uri).Query);
        authorizationContextId = query.TryGetValue("ctx", out var ctxValue) ? ctxValue.ToString() : string.Empty;
        ErrorMessage = query.TryGetValue("error_description", out var errorValue) ? errorValue.ToString() : string.Empty;

        if (string.IsNullOrWhiteSpace(authorizationContextId))
        {
            SetRequestError("Missing authorization context id.");
            return;
        }

        preAuthorization = await authorizationStore.GetPreAuthorization(authorizationContextId);

        if (preAuthorization is null)
        {
            SetRequestError("Authorization context is invalid or expired.");
            return;
        }

        try
        {
            IReadOnlySet<string> scopeSet =
                preAuthorization.Scopes!
                    .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                    .ToHashSet(StringComparer.OrdinalIgnoreCase);

            ui = await PageUiUseCase.BuildAsync(
                scopeSet,
                preAuthorization.TenantId,
                preAuthorization.ClientId_FK,
                CancellationToken.None);

            if (ui?.AllowSignup != true)
            {
                SetRequestError("Self-registration is not enabled for this client.");
            }
        }
        catch (AuthorizationRequestException ex)
        {
            SetRequestError(ex.ErrorDescription);
        }
        catch (Exception ex)
        {
            SetRequestError(ex.Message);
        }
    }

    private string BuildLoginUrl(bool created, bool verifyRequired)
    {
        var parameters = new Dictionary<string, string?>(StringComparer.Ordinal)
        {
            ["ctx"] = authorizationContextId
        };

        if (created)
        {
            parameters["created"] = "1";
        }

        if (verifyRequired)
        {
            parameters["verify"] = "1";
        }

        return QueryHelpers.AddQueryString("/login", parameters);
    }

    private string GetErrorDisplayStyle() => string.IsNullOrEmpty(ErrorMessage) ? "display:none;" : "";

    private void SetRequestError(string description)
    {
        isRequestValid = false;
        requestErrorMessage = description;
    }

    private static string GetCardStyle(string? accentHex)
    {
        var accentStyle = string.IsNullOrWhiteSpace(accentHex) ? string.Empty : $"--accent:{accentHex};";
        return $"{accentStyle}max-width:460px;";
    }
}

