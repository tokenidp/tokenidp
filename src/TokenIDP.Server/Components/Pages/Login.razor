@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.Extensions.Logging
@using System.Text.Json
@using TokenIDP.Core.Abstractions.Repositories
@using TokenIDP.Core.Foundation.Exceptions
@using TokenIDP.Core.OAuth
@using TokenIDP.Core.OAuth.Abstractions
@using TokenIDP.Core.OAuth.ExternalProviders.Abstractions
@using TokenIDP.Core.OAuth.Model
@using TokenIDP.Domain.AggregateRoots.Authorization
@using TokenIDP.Server.Middlewares
@using TokenIDP.Server.RESTClients

@page "/login"
@rendermode InteractiveServer

<PageTitle>Authorize</PageTitle>

@inject LoadService LoadService
@inject NavigationManager Navigation
@inject IAuthorizationRepository authorizationStore
@inject IAuthorizationPageUiUseCase PageUiUseCase
@inject AntiforgeryStateProvider AntiforgeryProvider
@inject IJSRuntime JSRuntime
@inject ILogger<Login> logger

@if (!isRequestValid)
{
    <p style="color:red;">@requestErrorMessage</p>
}
else if (ui != null)
{
    @* <div class="logo">
        @if (!string.IsNullOrWhiteSpace(ui.LogoUrl))
        {
            <img src="@ui.LogoUrl" alt="@ui.ProductName" style="height:42px;" />
        }
        else
        {
            <span>??</span>
        }
    </div> *@

    <div class="card" data-theme="@ui.Theme" style="@GetAccentStyle(ui.AccentColor)">
        <div class="logo">
            @if (!string.IsNullOrWhiteSpace(ui.LogoUrl))
            {
                <img src="@ui.LogoUrl" alt="@ui.ProductName logo" width="250" />
            }
            else
            {
                <img src="/_content/TokenIDP.Server/images/TokenIDP.svg" alt="TokenIDP logo" width="250" />
            }
        </div>

        <h1>Sign in to @ui.ProductName</h1>
        @if (!string.IsNullOrWhiteSpace(ui.LoginText))
        {
            <p>@ui.LoginText</p>
        }

        <div class="alert-danger" style="@GetErrorDisplayStyle()">@ErrorMessage</div>
        <div class="alert" style="@GetSuccessDisplayStyle()">@SuccessMessage</div>

        @if (ui.AllowLocalLogin)
        {
            <EditForm Model="@loginModel" OnValidSubmit="HandleLogin" FormName="LoginForm">
                <AntiforgeryToken />
                <DataAnnotationsValidator />
                <div class="field">
                    <label for="username">Username</label>
                    <InputText @bind-Value="loginModel.UserName" id="username" />
                    <ValidationMessage For="@(() => loginModel.UserName)" />
                </div>

                <div class="field">
                    <label for="password">Password</label>
                    <InputText @bind-Value="loginModel.Password" id="password" type="password" />
                    <ValidationMessage For="@(() => loginModel.Password)" />
                </div>

                <div class="options-row">
                    @if (ui.AllowStaySignedIn)
                    {
                        <label><InputCheckbox @bind-Value="loginModel.RememberMe" /> Stay signed in</label>
                    }

                    <a href="#" @onclick="GoToForgotPassword">Forgot password?</a>
                </div>
                <button type="submit" class="btn-primary">Sign In</button>
            </EditForm>
        }

        @* EXTERNAL PROVIDERS *@
        @if (ui.ExternalProviders.Any(x => x.Enabled))
        {
            <div class="divider">or</div>

            @foreach (var p in ui.ExternalProviders.Where(x => x.Enabled))
            {
                var providerUi = GetProviderUi(p.DisplayName);
                <button type="button" class="btn-secondary" @onclick="() => LoginWithProvider(p.DisplayName)">
                    <span class="btn-icon">@((MarkupString)providerUi.IconSvg)</span>
                    <span class="btn-text">@providerUi.ButtonText</span>
                </button>
            }
        }
    </div>

    @if (ui.AllowSignup)
    {
        <div class="footer">
            <span>Don't have an account?</span> <a href="#" @onclick="GoToSignup">@ui.SignupText</a>
        </div>
    }
}

@code {
    private sealed class LoginModel
    {
        [Required(ErrorMessage = "Username is required.")]
        public string UserName { get; set; } = default!;

        [Required(ErrorMessage = "Password is required.")]
        public string Password { get; set; } = default!;

        public bool RememberMe { get; set; }
    }

    private sealed record ExternalProviderUi(string ButtonText, string IconSvg);

    private AuthorizationPageUi? ui;
    private PreAuthorization? preAuthorization;

    private bool isRequestValid = true;
    private string requestErrorMessage = string.Empty;
    private string ErrorMessage = string.Empty;
    private string SuccessMessage = string.Empty;

    private string authorizationContextId = string.Empty;

    private readonly LoginModel loginModel = new();
    private Dictionary<string, string> QueryParams = new();

    protected override async Task OnInitializedAsync()
    {
        var query = QueryHelpers.ParseQuery(new Uri(Navigation.Uri).Query);
        authorizationContextId = query.TryGetValue("ctx", out var ctxValue) ? ctxValue.ToString() : string.Empty;
        var created = query.TryGetValue("created", out var createdValue) && createdValue == "1";
        var verifyRequired = query.TryGetValue("verify", out var verifyValue) && verifyValue == "1";
        var confirmed = query.TryGetValue("confirmed", out var confirmedValue) && confirmedValue == "1";

        SuccessMessage = confirmed
            ? "Your email has been confirmed. You can now sign in."
            : created && verifyRequired
                ? "Your account has been created. Check your email to confirm it before signing in."
                : created
                    ? "Your account has been created successfully. You can now sign in."
                    : string.Empty;

        if (string.IsNullOrWhiteSpace(authorizationContextId))
        {
            SetRequestError("invalid_request", "Missing authorization context id.");
            return;
        }

        preAuthorization = await authorizationStore.GetPreAuthorization(authorizationContextId);

        if (preAuthorization is null)
        {
            SetRequestError("invalid_request", "Authorization context is invalid or expired.");
            return;
        }

        try
        {
            var request = new AuthorizationRequest
            {
                ClientId = preAuthorization.ClientId ?? string.Empty,
                RedirectUri = preAuthorization.RedirectUri ?? string.Empty,
                Scopes = preAuthorization.Scopes ?? string.Empty,
                ResponseType = preAuthorization.GrantType ?? "code"
            };

            IReadOnlySet<string> scopeSet =
            preAuthorization.Scopes!.Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

            ui = await PageUiUseCase.BuildAsync(
                scopeSet,
                preAuthorization.TenantId,
                preAuthorization.ClientId_FK,
                CancellationToken.None);
        }
        catch (AuthorizationRequestException ex)
        {
            SetRequestError(ex.Error, ex.ErrorDescription);
        }
        catch (Exception ex)
        {
            SetRequestError("server_error", ex.Message);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await InitializeJs();
        }
    }

    private async Task InitializeJs()
    {
        await JSRuntime.InvokeVoidAsync("initializeLoginButton");
    }

    private async Task HandleLogin()
    {
        ErrorMessage = string.Empty;
        SuccessMessage = string.Empty;

        AuthorizationRequest request = new()
        {
            UserName = loginModel.UserName,
            Password = loginModel.Password,
            ClientId = preAuthorization?.ClientId!,
            CodeChallenge = preAuthorization?.CodeChallenge!,
            RedirectUri = preAuthorization?.RedirectUri!,
            CodeChallengeMethod = preAuthorization?.CodeChallengeMethod!,
            Scopes = preAuthorization?.Scopes!,
            RememberMe = loginModel.RememberMe,
            AuthorizationContextId = preAuthorization?.CorrelationId!,
            TenantId = preAuthorization?.TenantId ?? 0
        };

        try
        {
            LoadService.ShowLoader();

            var tokenRequest = AntiforgeryProvider.GetAntiforgeryToken();

            var authCodePayload = await JSRuntime.InvokeAsync<JsonElement>(
                "idpAuth.localLogin",
                request,
                tokenRequest?.Value);
            var authCodeResponse = AuthResponseDto.FromJson(authCodePayload);

            if (authCodeResponse?.IsSuccess == false)
            {
                ErrorMessage = authCodeResponse.Error ?? "Invalid login.";
                return;
            }

            if (authCodeResponse?.TwoFactorEnabled == true)
            {
                var uri = $"/mfa?uid={authCodeResponse.UserId}&corid={authCodeResponse.CorrelationId}&flow=authorize&redirect_uri={preAuthorization?.RedirectUri!}";
                Navigation.NavigateTo(uri);
                return;
            }

            Navigation.NavigateTo($"/authorize?ctx={preAuthorization?.CorrelationId}", forceLoad: true);
        }
        catch (Exception ex)
        {
            ErrorMessage = $"An error occurred: {ex.Message}";
        }
        finally
        {
            LoadService.HideLoader();
        }
    }

    private void GoToForgotPassword()
    {
        var url = QueryHelpers.AddQueryString("/forgot-password",
            new Dictionary<string, string?>(StringComparer.Ordinal)
            {
                ["ctx"] = authorizationContextId
            });

        Navigation.NavigateTo(url);
    }

    private void GoToSignup()
    {
        var url = QueryHelpers.AddQueryString(
            ui?.SignupUrl ?? "/signup",
            new Dictionary<string, string?>(StringComparer.Ordinal)
            {
                ["ctx"] = authorizationContextId
            });

        Navigation.NavigateTo(url);
    }

    private void LoginWithProvider(string providerKey)
    {
        var provider = providerKey.Trim();
        var challengePath = $"/external/{Uri.EscapeDataString(provider)}/challenge";
        var url = QueryHelpers.AddQueryString(
            challengePath,
            new Dictionary<string, string?> { ["ctx"] = authorizationContextId });

        Navigation.NavigateTo(url, forceLoad: true);
    }

