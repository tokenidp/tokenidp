                "</svg>"),
            _ => new($"Continue with {providerName}",
                "<svg viewBox='0 0 24 24'>" +
                "<circle fill='#475467' cx='12' cy='12' r='11' />" +
                "<path fill='#ffffff' d='M12 5.5a3.5 3.5 0 1 1 0 7 3.5 3.5 0 0 1 0-7zm0 8.5c2.7 0 5 1.4 5 3.1v.9H7v-.9c0-1.7 2.3-3.1 5-3.1z' />" +
