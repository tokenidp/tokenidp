    private string GetErrorDisplayStyle() => string.IsNullOrEmpty(ErrorMessage) ? "display:none;" : "";
    private string GetSuccessDisplayStyle() => string.IsNullOrEmpty(SuccessMessage) ? "display:none;" : "";

    private void SetRequestError(string error, string description, bool allowRedirect = true)
    {
        isRequestValid = false;
        requestErrorMessage = description;

        if (!allowRedirect) return;

        if (!string.IsNullOrWhiteSpace(preAuthorization?.RedirectUri!) && Uri.TryCreate(preAuthorization?.RedirectUri!, UriKind.Absolute, out _))
        {
            var parameters = new Dictionary<string, string?>(StringComparer.Ordinal)
            {
                ["error"] = error,
                ["error_description"] = description
            };

            if (!string.IsNullOrWhiteSpace(preAuthorization?.State!))
                parameters["state"] = preAuthorization?.State!;

            Navigation.NavigateTo(BuildRedirectUri(preAuthorization?.RedirectUri!, parameters), true);
        }
    }

    private static string BuildRedirectUri(string baseUri, IDictionary<string, string?> parameters)
        => QueryHelpers.AddQueryString(baseUri, parameters);

    private static string BuildAuthorizationContextId(IDictionary<string, string> queryParams)
    {
        var pairs = queryParams
            .Where(x => !string.Equals(x.Key, "ctx", StringComparison.OrdinalIgnoreCase))
            .Select(x => $"{Uri.EscapeDataString(x.Key)}={Uri.EscapeDataString(x.Value)}");

        return string.Join("&", pairs);
    }

    private static string GetAccentStyle(string? accentHex)
        => string.IsNullOrWhiteSpace(accentHex) ? "" : $"--accent:{accentHex};";
}

