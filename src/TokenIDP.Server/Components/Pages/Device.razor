@using Microsoft.AspNetCore.WebUtilities

@page "/device"

<PageTitle>Device Activation</PageTitle>

@inject NavigationManager Navigation

<div class="card">
    <h1>Activate Your Device</h1>

    <div class="alert-danger" style="@GetErrorStyle()">@ErrorMessage</div>

    @if (!IsApproved)
    {
        <form method="post" action="/device/form">
            <AntiforgeryToken />

            <div class="field">
                <label for="user-code">User Code</label>
                <div class="login-input-wrap">
                    <i class="fa-solid fa-key login-input-icon" aria-hidden="true"></i>
                    <input name="user_code" id="user-code" value="@UserCode" required />
                </div>
            </div>

            <div class="field">
                <label for="username">Username</label>
                <div class="login-input-wrap">
                    <i class="fa-solid fa-user login-input-icon" aria-hidden="true"></i>
                    <input name="username" id="username" required />
                </div>
            </div>

            <div class="field">
                <label for="password">Password</label>
                <div class="login-input-wrap">
                    <i class="fa-solid fa-lock login-input-icon" aria-hidden="true"></i>
                    <input name="password" id="password" type="password" required />
                </div>
            </div>

            <button type="submit" class="btn-primary">Activate Device</button>
        </form>
    }
    else
    {
        <div class="success-message">
            Device successfully activated.
            <br />
            You may now return to your device.
        </div>
    }
</div>

@code {
    private string UserCode = string.Empty;
    private string ErrorMessage = string.Empty;
    private bool IsApproved;

    protected override void OnInitialized()
    {
        var query = QueryHelpers.ParseQuery(new Uri(Navigation.Uri).Query);

        UserCode = query.TryGetValue("user_code", out var code) ? code.ToString() : string.Empty;
        ErrorMessage = query.TryGetValue("error_description", out var error) ? error.ToString() : string.Empty;
        IsApproved = query.TryGetValue("approved", out var approved) && approved == "1";
    }

    private string GetErrorStyle()
        => string.IsNullOrEmpty(ErrorMessage) ? "display:none;" : "";
}
