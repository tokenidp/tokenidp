@rendermode InteractiveServer
@implements IDisposable
@inject LoadService LoadService

@if (isLoading)
{
    <div class="loading-overlay" role="status" aria-live="polite" aria-label="Loading">
        <div class="loading-spinner"></div>
        <div class="loading-text">Loading...</div>
    </div>
}

@code {
    private bool isLoading;

    protected override void OnInitialized()
    {
        LoadService.OnShowLoader += HandleShowLoader;
        LoadService.OnHideLoader += HandleHideLoader;
    }

    private void HandleShowLoader()
    {
        isLoading = true;
        InvokeAsync(StateHasChanged);
    }

    private void HandleHideLoader()
    {
        isLoading = false;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        LoadService.OnShowLoader -= HandleShowLoader;
        LoadService.OnHideLoader -= HandleHideLoader;
    }
}
