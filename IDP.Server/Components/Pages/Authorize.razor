@using IDP.Core.Model
@using System.ComponentModel.DataAnnotations
@using IDP.Core.OAuth
@using System.Collections.Concurrent
@using Microsoft.Extensions.Logging


@page "/authorize"
@rendermode InteractiveServer

<PageTitle>Authorize</PageTitle>

@inject LoadService LoadService
@inject NavigationManager Navigation
@inject IAuthorizationCodeUseCase AuthService
@inject IJSRuntime JSRuntime
@inject ILogger<Authorize> logger

@if (!isRequestValid)
{
    <p style="color: red;">@requestErrorMessage</p>
}
else
{
    <div class="login-card">
        <div class="login-title">Welcome Back</div>
        <div class="login-sub">Please enter your credentials to login</div>

        <div class="alert-danger" id="general-error" style="@GetErrorDisplayStyle()">
            @ErrorMessage
        </div>

        <EditForm Model="@loginModel" OnValidSubmit="HandleLogin">
            <DataAnnotationsValidator />

            <label for="username" class="form-label">Username</label>
            <InputText @bind-Value="loginModel.UserName" id="username" class="form-control mb-3" />
            <ValidationMessage For="@(() => loginModel.UserName)" />

            <label for="password" class="form-label">Password</label>
            <InputText @bind-Value="loginModel.Password" id="password" type="password" class="form-control" />
            <ValidationMessage For="@(() => loginModel.Password)" />
            <a @onclick="GoToForgotPassword" class="forgot-link">Forgot password?</a>

            <button type="submit" class="btn btn-primary w-100 mt-4">Login</button>
        </EditForm>

        <!-- Divider -->
        <div class="divider">OR</div>

        <!-- External Login Providers -->
        <button class="btn btn-google w-100 mb-2">
            <span>🔴</span> Continue with Google
        </button>
        <button class="btn btn-microsoft w-100 mb-2">⚫ Continue with Microsoft</button>
        <button class="btn btn-facebook w-100">🔵 Continue with Facebook</button>
    </div>
}

@code {

    private sealed class LoginModel
    {
        [Required(ErrorMessage = "Username is required.")]
        public string UserName { get; set; }

        [Required(ErrorMessage = "Password is required.")]
        public string Password { get; set; }
    }

    private bool isRequestValid = true;
    private string requestErrorMessage = string.Empty;
    private string ErrorMessage = string.Empty;
    private string oauthParams = string.Empty;
    private string requestedScopes = string.Empty;
    private string clientId = string.Empty;
    private string redirectUri = string.Empty;
    private string codeChallenge = string.Empty;
    private string codeChallengeMethod = string.Empty;
    private string responseType = string.Empty;
    private string state = string.Empty;
    private readonly LoginModel loginModel = new();
    private Dictionary<string, string> QueryParams = new();


    protected override async Task OnInitializedAsync()
    {
        var uri = Navigation.Uri;

        oauthParams = new Uri(uri).Query;

        if (!string.IsNullOrEmpty(oauthParams))
        {
            var parsedParams = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(oauthParams);

            QueryParams = parsedParams.ToDictionary(
                kvp => kvp.Key,
                 kvp => kvp.Value is IEnumerable<string> values
                     ? string.Join(",", values)
                     : kvp.Value.ToString() ?? ""
                 );

            QueryParams.TryGetValue("state", out state);

            if (!QueryParams.TryGetValue("client_id", out clientId) || string.IsNullOrWhiteSpace(clientId))
            {
                SetRequestError("invalid_request", "Missing client_id.");
                return;
            }

            var client = await AuthService.ValidateClient(clientId);

            if (!client.IsValidClient)
            {
                SetRequestError("unauthorized_client", "Invalid client_id.", allowRedirect: false);
                return;
            }

            if (!QueryParams.TryGetValue("redirect_uri", out redirectUri) || string.IsNullOrWhiteSpace(redirectUri))
            {
                SetRequestError("invalid_request", "Missing redirect_uri.");
                return;
            }

            if (!Uri.TryCreate(redirectUri, UriKind.Absolute, out _))
            {
                SetRequestError("invalid_request", "Invalid redirect_uri.");
                return;
            }

            QueryParams.TryGetValue("response_type", out responseType);
            if (!string.Equals(responseType, "code", StringComparison.Ordinal))
            {
                SetRequestError("unsupported_response_type", "response_type must be 'code'.");
                return;
            }

            QueryParams.TryGetValue("scope", out requestedScopes);
            if (string.IsNullOrWhiteSpace(requestedScopes))
            {
                SetRequestError("invalid_request", "Missing scope.");
                return;
            }

            var allowedScopes = client.Scopes
                .ToHashSet(StringComparer.Ordinal);

            var requestedScopesHashSet = requestedScopes
                .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                .ToHashSet(StringComparer.Ordinal);

            var invalidScopes = requestedScopesHashSet.Except(allowedScopes).ToArray();
            if (invalidScopes.Length > 0)
            {
                SetRequestError("invalid_scope", $"Invalid scope: {string.Join(" ", invalidScopes)}.");
                return;
            }

            if (!requestedScopesHashSet.Contains("openid"))
            {
                SetRequestError("invalid_scope", "Missing 'openid' scope.");
                return;
            }

            QueryParams.TryGetValue("code_challenge", out codeChallenge);
            QueryParams.TryGetValue("code_challenge_method", out codeChallengeMethod);
        }
        else
        {
            SetRequestError("invalid_request", "Missing authorization parameters.");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await InitializeJs();
        }
    }

    private async Task InitializeJs()
    {
        await JSRuntime.InvokeVoidAsync("initializeLoginButton");
    }

    private async Task HandleLogin()
    {
        ErrorMessage = string.Empty;

        AuthRequest request = new()
        {
            UserName = loginModel.UserName,
            Password = loginModel.Password,
            ClientId = clientId,
            CodeChallenge = codeChallenge,
            RedirectUri = redirectUri,
            CodeChallengeMethod = codeChallengeMethod,
            Scopes = requestedScopes
        };

        try
        {
            LoadService.ShowLoader();

            var authCodeResponse = await AuthService.Authenticate(request);

            await Task.Delay(2000);

            if (authCodeResponse?.IsSuccess == false)
            {
                ErrorMessage = authCodeResponse?.Error ?? string.Empty;
                return;
            }

            if (authCodeResponse?.TwoFactorEnabled == true)
            {
                var uri = $"/mfa?uid={authCodeResponse?.UserId}&" +
                $"corid={authCodeResponse?.CorrelationId}&" +
                $"redirect_uri={redirectUri}";

                Navigation.NavigateTo(uri);
            }
            else
            {
                var parameters = new Dictionary<string, string?>(StringComparer.Ordinal)
                {
                    ["code"] = authCodeResponse?.AuthorizationCode
                };

                if (!string.IsNullOrWhiteSpace(state))
                {
                    parameters["state"] = state;
                }

                var uri = BuildRedirectUri(request.RedirectUri, parameters);
                Navigation.NavigateTo(uri, true);
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"An error occurred: {ex.Message}";
        }
        finally
        {
            LoadService.HideLoader();
        }
    }

    private void GoToForgotPassword()
    {
        Navigation.NavigateTo($"/forgot-password{oauthParams}");
    }

    private string GetErrorDisplayStyle() => string.IsNullOrEmpty(ErrorMessage) ? "display: none;" : "";

    private void LoginWithProvider(string provider)
    {
        Navigation.NavigateTo($"/forgot-password{oauthParams}");
    }

    private void SetRequestError(string error, string description, bool allowRedirect = true)
    {
        isRequestValid = false;
        requestErrorMessage = description;

        if (!allowRedirect)
        {
            return;
        }

        if (!string.IsNullOrWhiteSpace(redirectUri) && Uri.TryCreate(redirectUri, UriKind.Absolute, out _))
        {
            var parameters = new Dictionary<string, string?>(StringComparer.Ordinal)
            {
                ["error"] = error,
                ["error_description"] = description
            };

            if (!string.IsNullOrWhiteSpace(state))
            {
                parameters["state"] = state;
            }

            var uri = BuildRedirectUri(redirectUri, parameters);
            Navigation.NavigateTo(uri, true);
        }
    }

    private static string BuildRedirectUri(string baseUri, IDictionary<string, string?> parameters)
    {
        return Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString(baseUri, parameters);
    }
}