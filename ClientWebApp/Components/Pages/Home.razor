@page "/"
@using ClientWebApp.Authentication
@inject NavigationManager NavigationManager
@inject JwtAuthenticationStateProvider StateProvider

@rendermode InteractiveServer


<PageTitle>Home</PageTitle>

<header class="hero">
    <div class="overlay"></div>
    <div class="container text-center">
        <h1 class="display-4">Welcome to Our Business App</h1>
        <p class="lead">Streamline your operations with our powerful solutions.</p>
        <button class="btn btn-primary btn-lg" @onclick="Login">Login</button>
    </div>
</header>

<!-- Features Section -->
<section class="features container text-center">
    <div class="row">
        <div class="col-md-4">
            <i class="bi bi-shield-lock feature-icon"></i>
            <h3>Secure & Scalable</h3>
            <p>Built with modern security standards to protect your data.</p>
        </div>
        <div class="col-md-4">
            <i class="bi bi-speedometer feature-icon"></i>
            <h3>Blazing Fast Performance</h3>
            <p>Optimized for speed and efficiency for all users.</p>
        </div>
        <div class="col-md-4">
            <i class="bi bi-cloud-upload feature-icon"></i>
            <h3>Cloud-Ready</h3>
            <p>Deploy and scale effortlessly on the cloud.</p>
        </div>
    </div>
</section>

<!-- Call to Action -->
<section class="cta text-center">
    <div class="container">
        <h2>Get Started Today</h2>
        <p class="lead">Join thousands of businesses improving efficiency with our solution.</p>   
    </div>
</section>

@code{
    private async Task Login()
    {
        var clientId = "123456789";
        var redirectUri = "https://localhost:7202/Counter";
        var pkce = PkceHelper.GeneratePkce();
        var codeChallenge = pkce.CodeChallenge;

        await StateProvider.StoreCodeVerifierAsync(pkce.CodeVerifier);

        var authUrl = $"https://localhost:7217/authorize?client_id={clientId}&redirect_uri={redirectUri}&response_type=code&code_challenge={codeChallenge}";

        NavigationManager.NavigateTo(authUrl, true);
    }
}

<style>
    .hero {
        position: relative;
        background: url('https://source.unsplash.com/1600x900/?business,technology') center/cover no-repeat;
        color: white;
        padding: 100px 0;
    }

    .overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.5);
    }

    .hero .container {
        position: relative;
        z-index: 2;
    }

    .features {
        padding: 164px 0;
    }

    .feature-icon {
        font-size: 40px;
        color: #007bff;
        margin-bottom: 15px;
    }

    .cta {
        background: #007bff;
        color: white;
        padding: 50px 0;
    }

        .cta .btn-light {
            border: 2px solid white;
        }
</style>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">
