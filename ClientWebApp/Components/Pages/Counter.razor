@page "/counter"
@using ClientWebApp.Authentication
@rendermode InteractiveServer

@inject NavigationManager Navigation
@inject AuthenticationService AuthService

<PageTitle>Counter</PageTitle>

<style>
    body {
        margin: 0;
        padding: 0;
        font-family: "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        background: linear-gradient(135deg, #1e3c72, #2a5298);
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .welcome-card {
        background: #ffffff;
        width: 420px;
        padding: 32px 36px;
        border-radius: 14px;
        box-shadow: 0 25px 50px rgba(0, 0, 0, 0.2);
        text-align: center;
        animation: fadeIn 0.6s ease-out;
    }

    .welcome-card h1 {
        margin: 0;
        font-size: 26px;
        color: #1e293b;
        font-weight: 600;
    }

    .welcome-card .subtitle {
        margin-top: 6px;
        color: #64748b;
        font-size: 14px;
    }

    .divider {
        height: 1px;
        background: #e5e7eb;
        margin: 24px 0;
    }

    .greeting {
        font-size: 22px;
        font-weight: 500;
        color: #0f172a;
        margin-bottom: 6px;
    }

    .username {
        color: #2563eb;
        font-weight: 600;
    }

    .status {
        margin-top: 12px;
        font-size: 14px;
        color: #475569;
    }

    .counter {
        font-size: 32px;
        font-weight: 700;
        margin: 12px 0;
        color: #1e40af;
    }

    .action-btn {
        margin-top: 18px;
        background: linear-gradient(135deg, #2563eb, #1d4ed8);
        color: #ffffff;
        border: none;
        padding: 12px 20px;
        font-size: 15px;
        border-radius: 8px;
        cursor: pointer;
        width: 100%;
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }

    .action-btn:hover {
        transform: translateY(-1px);
        box-shadow: 0 10px 20px rgba(37, 99, 235, 0.3);
    }

    .footer {
        margin-top: 22px;
        font-size: 12px;
        color: #94a3b8;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(8px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<div class="welcome-card">
    <h1>Welcome</h1>
    <div class="subtitle">You have successfully signed in</div>

    <div class="divider"></div>

    <div class="greeting">
        Hello, <span class="username">@userName</span>
    </div>

    <div class="status">Current counter value</div>
    <div class="counter">@currentCount</div>

    <button class="action-btn" @onclick="IncrementCount">
        Increment Counter
    </button>

    <div class="footer">
        Secure authentication powered by your Identity Server
    </div>
</div>


@code {
    private int currentCount = 0;
    private string authCode = string.Empty;
    private string userName = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var uri = new Uri(Navigation.Uri);
        var queryParams = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);

        if (queryParams.TryGetValue("code", out var codeValues))
        {
            authCode = codeValues.FirstOrDefault() ?? string.Empty;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            userName = await AuthService.ExchangeCodeForToken(authCode);

            StateHasChanged();
        }
    }

    private void IncrementCount()
    {
        currentCount++;
    }
}
