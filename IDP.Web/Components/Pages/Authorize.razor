@using IDP.Web.Model
@using System.ComponentModel.DataAnnotations

@page "/authorize"
@rendermode InteractiveServer

<PageTitle>Authorize</PageTitle>

@inject NavigationManager Navigation
@inject AuthenticationService AuthService

@if (!isValidClientId)
{
    <p style="color: red;">Invalid Client ID. Please check the Client ID and try again.</p>
}
else
{
    <div class="login-container">
        <div class="login-image">
            <img src="images/professional.svg" alt="Professional Illustration">
        </div>
        <div class="login-form">
            <div class="form-header">
                <h2>Welcome Back</h2>
                <p>Please enter your credentials to login</p>
            </div>

            <div class="alert-danger" id="general-error" style="@(string.IsNullOrEmpty(ErrorMessage) ? "display:none" : "")">
                @ErrorMessage
            </div>

            <EditForm Model="@loginModel" OnValidSubmit="HandleLogin">
                <DataAnnotationsValidator />

                <div class="form-group">
                    <label for="username">Username</label>
                    <InputText @bind-Value="loginModel.UserName" id="username" class="form-control" />
                    <ValidationMessage For="@(() => loginModel.UserName)" />
                </div>

                <div class="form-group">
                    <label for="password">Password</label>
                    <InputText @bind-Value="loginModel.Password" id="password" type="password" class="form-control" />
                    <ValidationMessage For="@(() => loginModel.Password)" />
                    <a href="#" class="forgot-password">Forgot password?</a>
                </div>

                <button type="submit" class="btn btn-primary">Login</button>
            </EditForm>

            @*    <div class="form-group">
                <label for="userName">Username</label>
                <input type="text" id="userName" @bind="userName" class="form-control" placeholder="Enter your username" required>
                <div class="invalid-feedback">Please enter your username</div>
            </div>

            <div class="form-group">
                <label for="password">Password</label>
                <input type="password" id="password" @bind="password" class="form-control" placeholder="Enter your password" required>
                <div class="invalid-feedback">Please enter your password</div>
                <a href="#" class="forgot-password">Forgot password?</a>
            </div>

            <button id="login-btn" @onclick="async () => await HandleLogin()" class="btn btn-primary">Login</button> *@

            @*  <div class="signup-link">
                Don't have an account? <a href="#">Sign up</a>
            </div> *@
        </div>
    </div>

    @*  <div class="login-container">
        <div class="login-image">
            <img src="images/professional.svg" alt="Professional Illustration">
        </div>

        <div class="login-form">
            <h2>Login</h2>
            <div>
                <label for="userName">User Name</label>
                <input @bind="userName" type="text" class="form-control" placeholder="Enter your username" />
            </div>
            <div>
                <label for="password">Password</label>
                <input @bind="password" type="password" class="form-control" placeholder="Enter your password" />
            </div>
            <button @onclick="async () => await HandleLogin()" class="btn btn-primary">Login</button>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="error" style="color: red;">@errorMessage</div>
            }
        </div>
    </div> *@
}

@code {
    private bool isValidClientId = true;
    private string Scopes = string.Empty;
    private string ErrorMessage = string.Empty;
    private readonly LoginModel loginModel = new();
    private Dictionary<string, string> QueryParams = new();

    protected override async Task OnInitializedAsync()
    {
        var uri = Navigation.Uri;
        var queryParams = new Uri(uri).Query;

        if (!string.IsNullOrEmpty(queryParams))
        {
            var parsedParams = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(queryParams);

            QueryParams = parsedParams.ToDictionary(
                kvp => kvp.Key,
                 kvp => kvp.Value is IEnumerable<string> values
                     ? string.Join(",", values)
                     : kvp.Value.ToString() ?? ""
                 );

            var client = await AuthService.GetClient(QueryParams["client_id"]);

            isValidClientId = client.IsValidClient;
            Scopes = client.Scopes;
        }
    }

    private async Task HandleLogin()
    {
        ErrorMessage = string.Empty;

        AuthRequest request = new()
            {
                UserName = loginModel.UserName,
                Password = loginModel.Password,
                ClientId = QueryParams["client_id"],
                CodeChallenge = QueryParams["code_challenge"],
                RedirectUri = QueryParams["redirect_uri"],
                CodeChallengeMethod = "SHA-256",
                Scopes = Scopes
            };

        try
        {
            var authCodeResponse = await AuthService.Authenticate(request);

            if (authCodeResponse?.IsSuccess == false)
            {
                ErrorMessage = authCodeResponse?.ErrorMessage ?? string.Empty;
                return;
            }

            if (authCodeResponse?.Value.TwoFactorEnabled == true)
            {
                Navigation.NavigateTo("/mfa", true);
            }
            else
            {
                var uri = $"{request.RedirectUri}?code={authCodeResponse?.Value.AuthorizationCode}";
                Navigation.NavigateTo(uri, true);
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"An error occurred: {ex.Message}";
        }
    }

    private class LoginModel
    {
        [Required(ErrorMessage = "Username is required")]
        public string UserName { get; set; }

        [Required(ErrorMessage = "Password is required")]
        public string Password { get; set; }
    }
}