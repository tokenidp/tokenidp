@page "/mfa"

@rendermode InteractiveServer

@inject NavigationManager Navigation
@inject AuthenticationService AuthService
@inject IJSRuntime JSRuntime

<div class="mfa-container">
    <h2>Multi-Factor Authentication</h2>
    <p>Please enter the 6-digit verification code sent to your email.</p>

    <EditForm Model="@mfaModel" OnValidSubmit="@VerifyCode">
        <div class="code-input-container">

            @for (int i = 0; i < 6; i++)
            {
                int index = i; // Capture the current index for the lambda
                <input type="text"
                       maxlength="1"
                       class="code-input @(IsInvalid ? "invalid" : "")"
                       @bind="mfaModel.Digits[index]"
                       @oninput="@(e => HandleInput(e, index))"
                       @onkeydown="@(e => HandleKeyDown(e, index))"
                       @onfocus="ClearError"
                       @onclick="@(() => HandlePaste())"
                       autocomplete="one-time-code"
                       inputmode="numeric"
                       pattern="[0-9]*" />
            }
        </div>

        @if (IsInvalid)
        {
            <div class="validation-message">Invalid verification code. Please try again.</div>
        }

        <div class="button-container">
            <button type="submit" class="btn btn-primary">Verify</button>
            <button type="button" class="btn btn-secondary" @onclick="ResendCode">Resend Code</button>
        </div>
    </EditForm>

    @if (IsResending)
    {
        <div class="resend-message">Sending new code...</div>
    }
    else if (WasResent)
    {
        <div class="resend-message">New code sent successfully!</div>
    }
</div>

@code {
    private MfaModel mfaModel = new();
    private bool IsInvalid { get; set; }
    private bool IsResending { get; set; }
    private bool WasResent { get; set; }

    private class MfaModel
    {
        public string[] Digits { get; set; } = new string[6];
    }

    private void HandleInput(ChangeEventArgs e, int currentIndex)
    {
        var value = e.Value?.ToString();

        if (!string.IsNullOrEmpty(value) && value.Length == 1 && char.IsDigit(value[0]))
        {
            mfaModel.Digits[currentIndex] = value;

            // Auto-focus to next input
            if (currentIndex < 5)
            {
                FocusNextInput(currentIndex);
            }
        }
        else
        {
            mfaModel.Digits[currentIndex] = string.Empty;
        }
    }

    private void HandleKeyDown(KeyboardEventArgs e, int currentIndex)
    {
        // Handle backspace to move to previous input
        if (e.Key == "Backspace" && string.IsNullOrEmpty(mfaModel.Digits[currentIndex]) && currentIndex > 0)
        {
            FocusPreviousInput(currentIndex);
        }
    }

    private async void HandlePaste()
    {
        try
        {
            var pastedText = await JSRuntime.InvokeAsync<string>("readClipboard");
            if (!string.IsNullOrEmpty(pastedText))
            {
                var digits = pastedText.Where(char.IsDigit).Take(6).ToArray();

                for (int i = 0; i < digits.Length && i < 6; i++)
                {
                    mfaModel.Digits[i] = digits[i].ToString();
                }

                // Focus the last input box with a value
                int lastFilled = digits.Length - 1;
                if (lastFilled >= 0 && lastFilled < 5)
                {
                    FocusNextInput(lastFilled);
                }
            }
        }
        catch
        {
            // Couldn't read clipboard, ignore
        }
    }


    private void FocusNextInput(int currentIndex)
    {
        // Use JS interop to focus the next input
        JSRuntime.InvokeVoidAsync("focusElement", $"input.code-input:nth-of-type({currentIndex + 2})");
    }

    private void FocusPreviousInput(int currentIndex)
    {
        JSRuntime.InvokeVoidAsync("focusElement", $"input.code-input:nth-of-type({currentIndex})");
    }

    private void ClearError()
    {
        IsInvalid = false;
    }

    private async Task VerifyCode()
    {
        var code = string.Join("", mfaModel.Digits);

        if (code.Length != 6 || !code.All(char.IsDigit))
        {
            IsInvalid = true;
            return;
        }

        // Here you would typically call your authentication service
        // For demonstration, we'll simulate a network call
        try
        {
            IsInvalid = false;

            // Simulate API call
            await Task.Delay(500);

            // Replace with actual verification logic
            bool isValid = await VerifyCodeWithServer(code);

            if (isValid)
            {
                // Redirect to authorized page
                Navigation.NavigateTo("/", true);

            }
            else
            {
                IsInvalid = true;
            }
        }
        catch
        {
            IsInvalid = true;
        }
    }

    private async Task<bool> VerifyCodeWithServer(string code)
    {
        // Replace with actual server verification
        // This is just a demo - in production, you'd call your backend API
        await Task.Delay(300); // Simulate network delay
        return code == "123456"; // Demo - accepts any 6-digit code in development
    }

    private async Task ResendCode()
    {
        IsResending = true;
        WasResent = false;

        try
        {
            // Simulate resend API call
            await Task.Delay(800);

            // Replace with actual resend logic
            await SendNewCodeToUser();

            WasResent = true;

            // Clear the form
            mfaModel = new MfaModel();
        }
        finally
        {
            IsResending = false;
        }
    }

    private async Task SendNewCodeToUser()
    {
        // Replace with actual code sending logic
        await Task.Delay(300); // Simulate network delay
    }
}