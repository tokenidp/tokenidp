@page "/mfa"
@using IDP.Web.Authentication
@using IDP.Web.Model

@rendermode InteractiveServer

@inject NavigationManager Navigation
@inject MfaService MfaService
@inject IJSRuntime JSRuntime

<div class="mfa-container">
    <h2>Multi-Factor Authentication</h2>
    <p>Please enter the 6-digit verification code sent to your email.</p>

    <EditForm Model="@mfaModel" OnValidSubmit="@VerifyCode">
        <div class="code-input-container">

            @for (int i = 0; i < 6; i++)
            {
                int index = i;
                <input type="text"
                       maxlength="1"
                       class="code-input @(IsInvalid ? "invalid" : "")"
                       @bind="mfaModel.Digits[index]"
                       @oninput="@(e => HandleInput(e, index))"
                       @onkeydown="@(e => HandleKeyDown(e, index))"
                       @onfocus="ClearError"
                       @onclick="@(() => HandlePaste())"
                       autocomplete="one-time-code"
                       inputmode="numeric"
                       pattern="[0-9]*" />
            }
        </div>

        @if (IsInvalid)
        {
            <div class="validation-message">@ErrorMessage</div>
        }

        <div class="button-container">
            <button type="submit" class="btn btn-primary" disabled="@isLoading">Verify</button>
            <button type="button" class="btn btn-secondary" @onclick="ResendCode" disabled="@isLoading">Resend Code</button>
        </div>
    </EditForm>

    @if (IsResending)
    {
        <div class="resend-message">Sending new code...</div>
    }
    else if (WasResent)
    {
        <div class="resend-message">New code sent successfully!</div>
    }
</div>

@code {

    private sealed class MfaModel
    {
        public string[] Digits { get; set; } = new string[6];
    }

    private MfaModel mfaModel = new();
    private bool IsInvalid { get; set; }
    private bool IsResending { get; set; }
    private bool WasResent { get; set; }
    private string ErrorMessage;
    private bool isLoading;
    private Dictionary<string, string> QueryParams = new();

    protected override void OnInitialized()
    {
        var uri = Navigation.Uri;
        var queryParams = new Uri(uri).Query;

        if (!string.IsNullOrEmpty(queryParams))
        {
            var parsedParams = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(queryParams);

            QueryParams = parsedParams.ToDictionary(
                kvp => kvp.Key,
                 kvp => kvp.Value is IEnumerable<string> values
                     ? string.Join(",", values)
                     : kvp.Value.ToString() ?? ""
                 );
        }
    }

    private void HandleInput(ChangeEventArgs e, int currentIndex)
    {
        var value = e.Value?.ToString();

        if (!string.IsNullOrEmpty(value) && value.Length == 1 && char.IsDigit(value[0]))
        {
            mfaModel.Digits[currentIndex] = value;

            // Auto-focus to next input
            if (currentIndex < 5)
            {
                FocusNextInput(currentIndex);
            }
        }
        else
        {
            mfaModel.Digits[currentIndex] = string.Empty;
        }
    }

    private void HandleKeyDown(KeyboardEventArgs e, int currentIndex)
    {
        // Handle backspace to move to previous input
        if (e.Key == "Backspace" && string.IsNullOrEmpty(mfaModel.Digits[currentIndex])
        && currentIndex > 0)
        {
            FocusPreviousInput(currentIndex);
        }
    }

    private async Task HandlePaste()
    {
        try
        {
            var pastedText = await JSRuntime.InvokeAsync<string>("readClipboard");
            if (!string.IsNullOrEmpty(pastedText))
            {
                var digits = pastedText.Where(char.IsDigit).Take(6).ToArray();

                for (int i = 0; i < digits.Length && i < 6; i++)
                {
                    mfaModel.Digits[i] = digits[i].ToString();
                }

                // Focus the last input box with a value
                int lastFilled = digits.Length - 1;
                if (lastFilled >= 0 && lastFilled < 5)
                {
                    FocusNextInput(lastFilled);
                }
            }
        }
        catch
        {
            // Couldn't read clipboard, ignore
        }
    }

    private void FocusNextInput(int currentIndex)
    {
        // Use JS interop to focus the next input
        JSRuntime.InvokeVoidAsync("focusElement", $"input.code-input:nth-of-type({currentIndex + 2})");
    }

    private void FocusPreviousInput(int currentIndex)
    {
        JSRuntime.InvokeVoidAsync("focusElement", $"input.code-input:nth-of-type({currentIndex})");
    }

    private void ClearError()
    {
        IsInvalid = false;
    }

    private async Task VerifyCode()
    {
        var code = string.Join("", mfaModel.Digits);

        if (code.Length != 6 || !code.All(char.IsDigit))
        {
            IsInvalid = true;
            return;
        }

        try
        {
            IsInvalid = false;

            await VerifyCodeWithServer(code);
        }
        catch
        {
            IsInvalid = true;
        }
    }

    private async Task VerifyCodeWithServer(string code)
    {
        isLoading = true;
        ErrorMessage = string.Empty;

        var mfaRequest = new MfaRequest()
            {
                CorrelationId = QueryParams["corid"],
                Code = code,
                UserId = Convert.ToInt32(QueryParams["uid"])
            };

        var result = await MfaService.VerifyMfaAsync(mfaRequest);

        if (result.IsSuccess)
        {
            isLoading = false;

            var redirectUri = Uri.UnescapeDataString(QueryParams["redirect_uri"]);

            var uri = $"{redirectUri}?code={result?.Value.AuthorizationCode}";

            Navigation.NavigateTo(uri, true);
        }
        else
        {
            ErrorMessage = result.Value.Error;
            IsInvalid = true;
        }

        isLoading = false;
    }

    private async Task ResendCode()
    {
        IsResending = true;
        WasResent = false;

        try
        {
            await SendNewCodeToUser();

            WasResent = true;

            // Clear the form
            mfaModel = new MfaModel();
        }
        finally
        {
            IsResending = false;
        }
    }

    private async Task SendNewCodeToUser()
    {
        var mfaRequest = new MfaRequest()
            {
                CorrelationId = QueryParams["corid"],
                UserId = Convert.ToInt32(QueryParams["uid"])
            };

        var result = await MfaService.ResendMfaCodeAsync(mfaRequest);

        if (!result.IsSuccess)
        {
            ErrorMessage = result.Value.Error;
            IsInvalid = true;
        }
    }
}