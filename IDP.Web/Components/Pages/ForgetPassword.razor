@page "/forgot-password"
@rendermode InteractiveServer

@using System.ComponentModel.DataAnnotations
@inject NavigationManager NavigationManager

<PageTitle>Forget Password</PageTitle>

<div class="login-form">
    <div class="form-header">
        <h2>Reset Your Password</h2>
        <p>Enter your email to receive a reset link</p>
    </div>

    <div class="alert-danger" id="general-error" style="@GetErrorDisplayStyle()">
        @ErrorMessage
    </div>

    <div class="alert-success" id="success-message" style="@GetSuccessDisplayStyle()">
        @SuccessMessage
    </div>

    <EditForm Model="@forgotPasswordModel" OnValidSubmit="HandlePasswordReset">
        <DataAnnotationsValidator />

        <div class="form-group">
            <label for="email">Email Address</label>
            <InputText @bind-Value="forgotPasswordModel.Email" id="email" type="email" class="form-control" />
            <ValidationMessage For="@(() => forgotPasswordModel.Email)" />
        </div>

        <button type="submit" class="btn btn-primary">Send Reset Link</button>

        <div class="back-to-login">
            <a @onclick="ReturnToLogin" class="text-link" style="cursor: pointer;">← Back to Login</a>
        </div>
    </EditForm>
</div>

@code {

    public class ForgotPasswordModel
    {
        [Required(ErrorMessage = "Email is required.")]
        [EmailAddress(ErrorMessage = "Invalid email format.")]
        public string Email { get; set; }
    }

    private ForgotPasswordModel forgotPasswordModel = new ForgotPasswordModel();
    private string ErrorMessage = string.Empty;
    private string SuccessMessage = string.Empty;
    private string oauthParams = string.Empty;

    protected override void OnInitialized()
    {
        var uri = NavigationManager.Uri;

        oauthParams = new Uri(uri).Query;
    }

    private async Task HandlePasswordReset()
    {
        try
        {
            // Simulate API call
            await Task.Delay(500);

            // Replace with actual password reset logic
            SuccessMessage = $"Reset link sent to {forgotPasswordModel.Email}";
            ErrorMessage = string.Empty;

            // Clear form
            forgotPasswordModel.Email = string.Empty;
        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
            SuccessMessage = string.Empty;
        }
    }

    private void ReturnToLogin()
    {
        NavigationManager.NavigateTo($"/authorize{oauthParams}");
    }

    private string GetErrorDisplayStyle() => string.IsNullOrEmpty(ErrorMessage) ? "display: none;" : "";

    private string GetSuccessDisplayStyle() => string.IsNullOrEmpty(SuccessMessage) ? "display: none;" : "";

}